# Copy to .env and fill in real values. Never commit the real .env file.

# --- Database ---
DATABASE_URL="postgresql://user:password@localhost:5432/abingdon_library"

# --- Session / auth ---
SESSION_SECRET="generate-a-long-random-value"
GOOGLE_CLIENT_ID=""              # Abingdon's Google Cloud OAuth client ID
GOOGLE_WORKSPACE_DOMAIN="abingdon.org.uk"   # sign-up is restricted to this domain
RP_ID="library.abingdon.org.uk"  # WebAuthn relying party ID — must match the real deployed domain
ORIGIN="https://library.abingdon.org.uk"

# --- AI provider (pick one; ai.service.ts reads whichever is set) ---
AI_PROVIDER="groq"               # "groq" | "gemini" | "none"
GROQ_API_KEY=""                  # server-side only — rotate any key that was ever pasted in chat
GEMINI_API_KEY=""

# --- Third-party catalogue integrations (see backend/src/integrations) ---
VLEBOOKS_API_KEY=""
VLEBOOKS_ENDPOINT=""
BROWNS_API_KEY=""
AMAZON_BUSINESS_API_KEY=""
# No key needed for Open Library ISBN lookups — it's a free public API used for barcode enrichment.

# --- App ---
NODE_ENV="development"
PORT="4000"
